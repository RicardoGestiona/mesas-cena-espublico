# >= 32 random chars. Generate with: openssl rand -base64 48
# Rotating it invalidates all stored hashes: re-run the import afterwards.
EMAIL_HMAC_PEPPER=
# Comma-separated list of corporate email domains accepted by the lookup.
ALLOWED_EMAIL_DOMAINS=
# memory (local dev, reads SEATING_MEMORY_FILE) | redis (required in production)
SEATING_STORE=memory
SEATING_MEMORY_FILE=data/private/seating.hashed.json
RATE_LIMIT_PER_MINUTE=10
# Injected by the Upstash Redis Marketplace integration (or UPSTASH_REDIS_REST_URL/TOKEN)
KV_REST_API_URL=
KV_REST_API_TOKEN=
