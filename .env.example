# >= 32 random chars. Generate with: openssl rand -base64 48
# Rotating it invalidates all stored hashes: re-run the import afterwards.
EMAIL_HMAC_PEPPER=
# Comma-separated list of corporate email domains accepted by the lookup.
ALLOWED_EMAIL_DOMAINS=
# memory (local dev, reads SEATING_MEMORY_FILE) | redis (required in production)
SEATING_STORE=memory
SEATING_MEMORY_FILE=data/private/seating.hashed.json
RATE_LIMIT_PER_MINUTE=10
# ADMIN credentials, scripts only (seating:import). Injected by the Upstash Redis
# Marketplace integration (or UPSTASH_REDIS_REST_URL/TOKEN). Never needed by the app.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Runtime (SEATING_STORE=redis): least-privilege ACL users on the same database.
# seating token: `~seating -@all +hget` · ratelimit token: `~rl:lookup:* -@all +evalsha +eval +get +incrby +pexpire`
RUNTIME_REDIS_URL=
RUNTIME_REDIS_SEATING_TOKEN=
RUNTIME_REDIS_RATELIMIT_TOKEN=

# Public app URL. The redis import verifies itself against it (override with --verify-url).
APP_URL=https://mesas-cena-espublico.vercel.app
